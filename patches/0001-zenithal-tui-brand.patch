+//! NIZARI guard: no shipped code may install, update, or advertise OpenAI's software.
+//!
+//! Two tiers:
+//!   * **hard** patterns fail the build. These are supply-chain and misrouting risks:
+//!     anything that installs OpenAI's CLI/app over ours, or sends our users to
+//!     upstream's tracker, releases, installer scripts or announcement feed.
+//!   * **soft** patterns are reported but do not fail. They are ChatGPT-account
+//!     features (billing banners, help articles) that a BYOK user never reaches, or
+//!     deliberate security policy (the exec-server host allowlist). Tracked in
+//!     `zenithal/rebrand/strings.md` as debt; promoting one to `hard` is the fix.
+//!
+//! Shipped code only: `*_tests.rs`, `tests/` dirs and everything from the first
+//! `#[cfg(test)]` onwards is skipped, because tests legitimately use upstream URLs as
+//! fixtures. Lines starting with `//` are skipped so attribution comments are allowed.
+
+use std::path::{Path, PathBuf};
+
+fn hard_patterns() -> Vec<String> {
+    // Assembled from parts so this file does not trip its own check.
+    let gh = "github.com";
+    let o = "openai";
+    let c = "chatgpt";
+    vec![
+        format!("@{o}/codex"),                      // npm/bun/pnpm/vp package
+        format!("{gh}/{o}/codex/releases"),         // release + release-notes links
+        format!("api.{gh}/repos/{o}/codex"),        // update checks against upstream
+        format!("cask/codex.json"),                 // upstream Homebrew cask
+        format!("{gh}/{o}/codex/issues"),           // bug reports
+        format!("{gh}/{o}/codex/main"),             // announcement feed
+        format!("{c}.com/codex/install"),           // curl | sh installers
+        format!("oaistatic.com/codex-app-prod"),    // desktop app downloads
+        format!("\"--cask\", \"codex\""),           // brew cask
+    ]
+}
+
+fn soft_patterns() -> Vec<String> {
+    let o = "openai";
+    let c = "chatgpt";
+    vec![
+        format!("help.{o}.com"),
+        format!("developers.{o}.com"),
+        format!("auth.{o}.com"),
+        format!("{o}.com/form"),
+        format!("{c}.com/settings"),
+        format!("{c}.com/admin"),
+        format!("{c}.com/backend-api"),
+        format!("learn.{c}.com"),
+        format!("persistent.oaistatic.com"),
+    ]
+}
+
+fn roots() -> Vec<PathBuf> {
+    let tui = Path::new(env!("CARGO_MANIFEST_DIR"));
+    let ws = tui.parent().expect("codex-rs");
+    vec![tui.join("src"), ws.join("cli").join("src")]
+}
+
+fn walk(dir: &Path, files: &mut Vec<PathBuf>) {
+    let Ok(entries) = std::fs::read_dir(dir) else { return };
+    for entry in entries.flatten() {
+        let p = entry.path();
+        if p.is_dir() {
+            if p.file_name().and_then(|n| n.to_str()) == Some("tests") {
+                continue;
+            }
+            walk(&p, files);
+        } else if p.extension().and_then(|e| e.to_str()) == Some("rs") {
+            files.push(p);
+        }
+    }
+}
+
+fn shipped_lines(path: &Path) -> Vec<(usize, String)> {
+    let name = path.file_name().and_then(|n| n.to_str()).unwrap_or("");
+    if name.ends_with("_tests.rs") || name == "tests.rs" {
+        return Vec::new();
+    }
+    let Ok(text) = std::fs::read_to_string(path) else { return Vec::new() };
+    let mut out = Vec::new();
+    for (i, line) in text.lines().enumerate() {
+        let t = line.trim_start();
+        if t.starts_with("#[cfg(test)]") || t.starts_with("#[cfg(all(test") {
+            break;
+        }
+        out.push((i + 1, line.to_string()));
+    }
+    out
+}
+
+fn scan(patterns: &[String]) -> Vec<String> {
+    let mut files = Vec::new();
+    for r in roots() {
+        walk(&r, &mut files);
+    }
+    assert!(
+        files.len() > 100,
+        "expected to scan tui+cli sources, found only {} files",
+        files.len()
+    );
+    let mut hits = Vec::new();
+    for f in &files {
+        let lines = shipped_lines(f);
+        for (idx, (line_no, line)) in lines.iter().enumerate() {
+            if line.trim_start().starts_with("//") {
+                continue;
+            }
+            // Explicit, auditable opt-out for a line that must reference upstream.
+            // A marker may sit a couple of comment lines above the code it excuses.
+            let window: String = lines[idx.saturating_sub(3)..idx]
+                .iter()
+                .map(|(_, l)| l.as_str())
+                .collect::<Vec<_>>()
+                .join("\n");
+            if line.contains("zenithal:allow-upstream-url") || window.contains("zenithal:allow-upstream-url") {
+                continue;
+            }
+            for pattern in patterns {
+                if line.contains(pattern.as_str()) {
+                    hits.push(format!(
+                        "{}:{}  '{}'\n      {}",
+                        f.display(),
+                        line_no,
+                        pattern,
+                        line.trim()
+                    ));
+                }
+            }
+        }
+    }
+    hits
+}
+
+#[test]
+fn no_supply_chain_or_misrouting_urls() {
+    let hits = scan(&hard_patterns());
+    assert!(
+        hits.is_empty(),
+        "Zenithal must not install, update, or advertise OpenAI's software.\n\
+         {} occurrence(s):\n\n{}\n\n\
+         These are supply-chain risks: `update` running `npm i -g @openai/codex` or\n\
+         `curl chatgpt.com/codex/install.sh | sh` replaces this fork with upstream.\n\
+         Fix by removing the feature or pointing it at our own releases.",
+        hits.len(),
+        hits.join("\n")
+    );
+}
+
+/// Informational: prints remaining ChatGPT-account coupling. Never fails, so it cannot
+/// block a release on cosmetic debt - but the count is visible in test output.
+#[test]
+fn audit_remaining_openai_coupling() {
+    let hits = scan(&soft_patterns());
+    if hits.is_empty() {
+        return;
+    }
+    println!(
+        "NIZARI audit: {} openai/chatgpt references remain in shipped code \
+         (ChatGPT-account features and security policy). See zenithal/rebrand/strings.md.",
+        hits.len()
+    );
+    for h in hits.iter().take(40) {
+        println!("  {h}");
+    }
+}
+
+#[test]
+fn attribution_is_present() {
+    // Apache-2.0 section 4(b): a fork must state that it is modified.
+    let ws = Path::new(env!("CARGO_MANIFEST_DIR")).parent().unwrap().parent().unwrap();
+    let mut found = false;
+    for candidate in ["NOTICE", "README.md", "LICENSE"] {
+        if let Ok(text) = std::fs::read_to_string(ws.join(candidate)) {
+            if text.to_lowercase().contains("codex") {
+                found = true;
+                break;
+            }
+        }
+    }
+    assert!(found, "no attribution to the upstream project in NOTICE/README/LICENSE");
+}
